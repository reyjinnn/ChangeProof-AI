{
  "name": "changeproof",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "changeproof": "./dist/cli/index.js"
  },
  "description": "ChangeProof AI 1.0 — investigates, fixes and independently verifies the impact of software changes across languages, frameworks, databases, events and repositories.",
  "license": "SEE LICENSE IN docs/decisions/",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": "26.12.1",
    "pnpm": "12.5.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/dashboard/tsconfig.json && tsc --noEmit -p apps/trace-viewer/tsconfig.json",
    "lint": "eslint . && depcruise --config .dependency-cruiser.cjs src apps",
    "lint:eslint": "eslint .",
    "lint:boundaries": "depcruise --config .dependency-cruiser.cjs src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/contracts tests/policy",
    "test:architecture": "vitest run tests/architecture",
    "test:adapters": "vitest run tests/adapters",
    "test:graph": "vitest run tests/graph",
    "test:negative": "vitest run tests/negative",
    "test:dependencies": "vitest run tests/dependencies",
    "test:security": "vitest run tests/security",
    "test:identity:native": "vitest run --config vitest.native.config.ts",
    "test:runner-security:native": "node scripts/runner-security-probes.mjs",
    "dev": "vite apps/dashboard",
    "build:ui": "vite build apps/dashboard",
    "test:ui": "vitest run --config apps/dashboard/vitest.config.ts",
    "test:trace": "vitest run --config apps/trace-viewer/vitest.config.ts",
    "build:trace": "vite build apps/trace-viewer",
    "test:e2e": "node tests/e2e/run.mjs",
    "verify": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "dependencies": {
    "octokit": "^5.0.5",
    "pg": "^8.23.1",
    "redis": "^6.3.1",
    "typescript": "5.9.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.8.0",
    "@types/pg": "^8.23.1",
    "axe-core": "4.10.2",
    "dependency-cruiser": "18.6.0",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "10.13.0",
    "happy-dom": "15.11.7",
    "playwright-core": "^1.64.1",
    "prisma": "6.19.1",
    "typescript-eslint": "8.71.2",
    "vite": "7.1.7",
    "vitest": "5.0.5"
  }
}
