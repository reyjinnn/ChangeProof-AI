{
  "name": "changeproof",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ChangeProof AI 1.0 — investigates, fixes and independently verifies the impact of software changes across languages, frameworks, databases, events and repositories.",
  "license": "SEE LICENSE IN docs/decisions/",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": "26.12.1",
    "pnpm": "12.5.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . && depcruise --config .dependency-cruiser.cjs src",
    "lint:eslint": "eslint .",
    "lint:boundaries": "depcruise --config .dependency-cruiser.cjs src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/contracts tests/policy",
    "test:architecture": "vitest run tests/architecture",
    "test:adapters": "vitest run tests/adapters",
    "test:graph": "vitest run tests/graph",
    "test:negative": "vitest run tests/negative",
    "test:dependencies": "vitest run tests/dependencies",
    "test:security": "vitest run tests/security",
    "test:runner-security:native": "node scripts/runner-security-probes.mjs",
    "test:identity:native": "vitest run tests/native/identity-rls.test.ts",
    "verify": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "dependencies": {
    "pg": "^8.23.1",
    "typescript": "5.9.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.8.0",
    "@types/pg": "^8.23.1",
    "dependency-cruiser": "18.6.0",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "10.13.0",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
