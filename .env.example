# Model broker (operator-owned credentials; target provider: Meta Muse Spark)
CHANGEPROOF_MODEL_PROVIDER=meta-muse-spark
CHANGEPROOF_MODEL_API_KEY=
CHANGEPROOF_MODEL_URL=https://api.meta.ai/v1
CHANGEPROOF_MODEL_NAME=muse-spark-1.3
CHANGEPROOF_MODEL_VERSION=1.3

# Modal Sandbox
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Runtime
CHANGEPROOF_ENV=development
CHANGEPROOF_LOG_LEVEL=info
CHANGEPROOF_RUNS_DIR=./runs
CHANGEPROOF_CACHE_DIR=./.cache

CP_GITHUB_CLIENT_ID=
CP_GITHUB_CLIENT_SECRET=
CP_GITHUB_REDIRECT_URL=http://127.0.0.1:4179/api/auth/github/callback
# Repository authority (FR3-30): operator-provisioned GitHub App installation
# token. Absent by default; without it providers report githubApp=false and
# github-probe exits BLOCKED. Sign-in alone never grants repo access.
CP_GITHUB_INSTALLATION_TOKEN=
# Mint-on-demand installation tokens (WP3-22): the App id plus a path to the
# App private key PEM, downloaded once from the App settings page. Both or
# neither; a partial pair refuses startup. Enables POST /api/github/connections.
CP_GITHUB_APP_ID=
CP_GITHUB_APP_KEY_FILE=

DEV_ADMIN_URL=
DEV_DB_NAME=

