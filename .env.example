# Model broker (operator-owned credentials; target provider: Meta Muse Spark)
CHANGEPROOF_MODEL_PROVIDER=meta-muse-spark
CHANGEPROOF_MODEL_API_KEY=
CHANGEPROOF_MODEL_URL=https://api.meta.ai/v1
CHANGEPROOF_MODEL_NAME=muse-spark-1.3
CHANGEPROOF_MODEL_VERSION=1.3

# Modal Sandbox
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Runtime
CHANGEPROOF_ENV=development
CHANGEPROOF_LOG_LEVEL=info
CHANGEPROOF_RUNS_DIR=./runs
CHANGEPROOF_CACHE_DIR=./.cache

